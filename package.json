{
  "name": "@sudobility/building_blocks",
  "version": "0.0.342",
  "description": "Higher-level shared UI building blocks for Sudobility apps",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./firebase": {
      "import": "./dist/firebase.js",
      "types": "./dist/firebase.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'node_modules' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'node_modules' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
    "@sudobility/components": "^5.3.45",
    "@sudobility/design": "^1.1.66",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase": "^11.0.0 || ^12.0.0",
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-helmet-async": "^2.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "i18next-browser-languagedetector": {
      "optional": true
    },
    "i18next-http-backend": {
      "optional": true
    },
    "@sudobility/auth-components": {
      "optional": true
    },
    "@sudobility/auth_lib": {
      "optional": true
    },
    "@sudobility/di": {
      "optional": true
    },
    "@sudobility/entity_client": {
